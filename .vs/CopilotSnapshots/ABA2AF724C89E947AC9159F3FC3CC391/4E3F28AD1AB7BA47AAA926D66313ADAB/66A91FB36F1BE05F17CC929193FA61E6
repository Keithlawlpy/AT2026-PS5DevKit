using System.Collections;
using UnityEngine;
using Unity.Cinemachine;
using StarterAssets;
using UnityEngine.EventSystems;
using UnityEngine.InputSystem;
using UnityEngine.InputSystem.PS5;


#if UNITY_PS5
using UnityEngine.PS5;
using PSInput = UnityEngine.PS5.PS5Input;
#endif

#if UNITY_EDITOR && UNITY_PS5
using DualSenseGamepad = UnityEngine.InputSystem.PS5.DualSenseGamepadPC;
#elif UNITY_PS5
using DualSenseGamepad = UnityEngine.InputSystem.PS5.DualSenseGamepad;
#endif

public class ThirdPersonShooterController : MonoBehaviour
{
    [SerializeField] private CinemachineCamera aimVirtualCamera;
    [SerializeField] private float normalSenitivity;
    [SerializeField] private float aimSenitivity;
    [SerializeField] private LayerMask aimColliderLayerMask = new LayerMask();
    [SerializeField] private Transform debugTransform;
    [SerializeField] private Transform pfBulletProjectile;
    [SerializeField] private Transform bulletSpawnPoint;
    [SerializeField, Range(0f, 1f)] private float shootLowFrequencyMotor = 0.25f;
    [SerializeField, Range(0f, 1f)] private float shootHighFrequencyMotor = 0.75f;
    [SerializeField] private float shootHapticDuration = 0.2f;

    private ThirdPersonController thirdPersonController;
    private StarterAssetsInputs starterAssetsInputs;

    private void Awake()
    {
        thirdPersonController = GetComponent<ThirdPersonController>();
        starterAssetsInputs = GetComponent<StarterAssetsInputs>();
    }

    private void Start()
    {
        foreach (InputDevice device in InputSystem.devices)
        {
            Debug.Log($"Device: {device.displayName}, Type: {device.GetType().FullName}");
        }
    }

    private void Update()
    {
        if (starterAssetsInputs.aim)
        {
            aimVirtualCamera.gameObject.SetActive(true);
            thirdPersonController.SetSensitivity(aimSenitivity);
        }
        else
        {
            aimVirtualCamera.gameObject.SetActive(false);
            thirdPersonController.SetSensitivity(normalSenitivity);
        }

        Vector2 screenCenterpPoint = new Vector2(Screen.width / 2f, Screen.height / 2f);
        Ray ray = Camera.main.ScreenPointToRay(screenCenterpPoint);

        if (Physics.Raycast(ray, out RaycastHit raycastHit, 999f, aimColliderLayerMask))
        {
            debugTransform.position = raycastHit.point;
            
        }

        Vector3 worldAimTarget = raycastHit.point;

        if (starterAssetsInputs.shoot)
        {
            Vector3 aimDirection = (worldAimTarget - bulletSpawnPoint.position).normalized;
            Instantiate(pfBulletProjectile, bulletSpawnPoint.position, Quaternion.LookRotation(aimDirection, Vector3.up));
            TriggerHaptics();
            starterAssetsInputs.shoot = false;


        }
    }

    private void TriggerHaptics()
    {
        DualSenseGamepad gamepad = DualSenseGamepad.current;
        if (gamepad == null)
        {
            return;
        }

        gamepad.SetMotorSpeeds(shootLowFrequencyMotor, shootHighFrequencyMotor);
        StartCoroutine(StopShootHaptics(gamepad));
    }

    private IEnumerator StopShootHaptics(Gamepad gamepad)
    {
        yield return new WaitForSecondsRealtime(shootHapticDuration);

        if (gamepad != null)
        {
            gamepad.SetMotorSpeeds(0f, 0f);
        }
    }


}
